# Abbreviations (Fish's preferred alternative to aliases)
# Managed by chezmoi

# Git
abbr -a g git
abbr -a ga 'git add'
abbr -a gc 'git commit'
abbr -a gp 'git push'
abbr -a gl 'git pull'
abbr -a gd 'git diff'
abbr -a gs 'git status'

# chezmoi
abbr -a cma 'chezmoi apply'
abbr -a cme 'chezmoi edit'
abbr -a cmd 'chezmoi diff'

# Navigation
abbr -a cdp 'cd ~/projects'

# uv
abbr -a uvs 'uv sync --extra dev'

# Local dev ports
alias ports '/Users/scott/.local/bin/ports-check'

# Xcode
abbr -a xcode-accept 'sudo xcodebuild -license accept'
