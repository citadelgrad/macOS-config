# Environment variables
# Managed by chezmoi

set -gx EDITOR {{ .editor.default | squote }}
set -gx VISUAL {{ .editor.default | squote }}
set -gx SOPS_EDITOR nano

# Ollama models on external drive (machine-specific)
{{ if eq (output "scutil" "--get" "ComputerName" | trim) "marcus" -}}
set -gx OLLAMA_MODELS "/Volumes/qwiizlab/scott/ollama/models"
{{ end -}}

# Claude Code
set -gx CLAUDE_CODE_ENABLE_TASKS true

# Load the Claude Code OAuth token from macOS Keychain.
if set -l claude_code_oauth_token (/usr/bin/security find-generic-password -a "$USER" -s "claude-code-oauth-token" -w 2>/dev/null)
    set -gx CLAUDE_CODE_OAUTH_TOKEN "$claude_code_oauth_token"
end
set -e claude_code_oauth_token
