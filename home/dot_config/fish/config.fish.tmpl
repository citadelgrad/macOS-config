# Fish shell configuration
# Managed by chezmoi -- edit with: chezmoi edit ~/.config/fish/config.fish

set -g fish_greeting ""

# Rust / Cargo
fish_add_path -g "$HOME/.cargo/bin"

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew (Apple Silicon vs Intel)
{{ if eq .chezmoi.arch "arm64" -}}
eval (/opt/homebrew/bin/brew shellenv)
{{ else -}}
eval (/usr/local/bin/brew shellenv)
{{ end -}}
{{ end -}}

# Automic Vault hardened stubs live in /usr/local/bin. This path must win
# over Homebrew so hardened tools (e.g. aws) resolve to the stub, not the
# real binary.
fish_add_path --move /usr/local/bin

# Fish loads conf.d/*.fish automatically before this file.
# PATH, env vars, abbreviations, and aliases are in conf.d/ files.

# Added by OrbStack: command-line tools and integration
source ~/.orbstack/shell/init2.fish 2>/dev/null || :

# Added by git-ai installer
fish_add_path -g "/Users/scott/.git-ai/bin"

alias bots '/Volumes/qwiizlab/projects/connect-the-bots/target/debug/pas'
alias openclaw 'ssh bot@100.121.21.88'

# MCP Agent Mail
alias am 'cd /Users/scott/projects/mcp_agent_mail && scripts/run_server_with_token.sh'

# Blender CLI
fish_add_path -g "/Volumes/qwiizlab/Applications/Blender.app/Contents/MacOS"

# OpenFang
fish_add_path -g /Users/scott/.openfang/bin

# Starship prompt (must be last)
set -gx STARSHIP_LOG error
starship init fish | source

# Hermes Agent — ensure ~/.local/bin is on PATH
fish_add_path "$HOME/.local/bin"
