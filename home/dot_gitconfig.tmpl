[core]
	editor = {{ .editor.default }}
	excludesfile = {{ .chezmoi.homeDir }}/.config/git/ignore
[user]
	email = {{ .git.email }}
	name = {{ .git.name }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
{{- if lookPath "delta" }}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
{{- end }}
