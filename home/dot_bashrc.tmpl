# Managed by chezmoi -- edit with: chezmoi edit ~/.bashrc

# =============================================================================
# HOMEBREW (Apple Silicon vs Intel)
# =============================================================================
{{ if eq .chezmoi.os "darwin" -}}
{{ if eq .chezmoi.arch "arm64" -}}
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
[[ -x /usr/local/bin/brew ]] && eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}
{{ end -}}

# =============================================================================
# LOCAL BIN
# =============================================================================
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# =============================================================================
# EDITOR
# =============================================================================
export EDITOR='{{ .editor.default }}'
export VISUAL='{{ .editor.default }}'
export SOPS_EDITOR="nano"

# =============================================================================
# DIRENV
# =============================================================================
if command -v direnv &> /dev/null; then
    eval "$(direnv hook bash)"
fi

# =============================================================================
# PYENV
# =============================================================================
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv &> /dev/null; then
    eval "$(pyenv init -)"
    eval "$(pyenv virtualenv-init -)"
fi

# =============================================================================
# BLENDER
# =============================================================================
export BLENDER_PATH="/Volumes/qwiizlab/Applications/Blender.app/Contents/MacOS"
export PATH="$BLENDER_PATH:$PATH"

# =============================================================================
# MODERN CLI ALIASES
# =============================================================================
if command -v lsd &> /dev/null; then
    alias ls='lsd'
    alias ll='lsd -la'
    alias la='lsd -a'
    alias lt='lsd --tree --depth=2'
fi

if command -v bat &> /dev/null; then
    alias cat='bat --paging=never'
fi

command -v uu-tail &> /dev/null && alias tail='uu-tail'
command -v uu-head &> /dev/null && alias head='uu-head'

# =============================================================================
# CLAUDE
# =============================================================================
if [[ -x /opt/homebrew/bin/claude ]]; then
    alias claude='env -u ANTHROPIC_API_KEY /opt/homebrew/bin/claude'
    alias cc='env -u ANTHROPIC_API_KEY /opt/homebrew/bin/claude --dangerously-skip-permissions'
fi

# =============================================================================
# NAVIGATION ALIASES
# =============================================================================
alias cdp='cd ~/projects'

# =============================================================================
# GIT-AI
# =============================================================================
[[ -d "$HOME/.git-ai/bin" ]] && export PATH="$HOME/.git-ai/bin:$PATH"

# =============================================================================
# DCG
# =============================================================================
# Warn if the hook was silently removed from Claude Code settings.
if command -v dcg &>/dev/null && command -v jq &>/dev/null; then
  if [ -f "$HOME/.claude/settings.json" ] && \
     ! jq -e '.hooks.PreToolUse[]? | select(.hooks[]?.command | test("dcg$"))' \
       "$HOME/.claude/settings.json" &>/dev/null; then
    printf '\033[1;33m[dcg] Hook missing from ~/.claude/settings.json — run: dcg install\033[0m\n'
  fi
fi
